<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SyrlasStudio.ViewModels"
             xmlns:models="clr-namespace:SyrlasStudio.Models"
             x:Class="SyrlasStudio.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="Syrlas Studio AI">

    <Grid ColumnDefinitions="300, *" RowDefinitions="*">

        <!-- ЛЕВАЯ ПАНЕЛЬ: Параметры, мониторинг и управление -->
        <ScrollView Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1E1E1E}" Padding="15">
            <VerticalStackLayout Spacing="15">
                
                <Label Text="Syrlas AI Studio" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

                <!-- Кнопки управления сессией -->
                <Button Text="Новый чат" Command="{Binding NewChatCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Text="Выгрузить лог" Command="{Binding ExportLogsCommand}" />

                <BoxView HeightRequest="1" Color="Gray" HorizontalOptions="Fill" />

                <!-- Мониторинг ресурсов -->
                <Label Text="Системные ресурсы" FontAttributes="Bold" FontSize="14" />
                
                <Label Text="{Binding CpuUsageText, StringFormat='CPU: {0}'}" FontSize="12" />
                <ProgressBar Progress="{Binding CpuProgress}" ProgressColor="DeepSkyBlue" />

                <Label Text="{Binding RamUsageText, StringFormat='RAM: {0}'}" FontSize="12" />
                <ProgressBar Progress="{Binding RamProgress}" ProgressColor="MediumSpringGreen" />

                <Label Text="{Binding DiskUsageText, StringFormat='Диск: {0}'}" FontSize="12" />
                <ProgressBar Progress="{Binding DiskProgress}" ProgressColor="Orange" />

                <!-- Исправлено: TextColor вместо ForegroundColor -->
                <Label Text="{Binding CurrentSpeedText, StringFormat='Скорость: {0}'}" FontAttributes="Bold" FontSize="13" TextColor="SlateGray" />

                <BoxView HeightRequest="1" Color="Gray" HorizontalOptions="Fill" />

                <!-- Настройки генерации -->
                <Label Text="Параметры генерации" FontAttributes="Bold" FontSize="14" />

                <StackLayout Orientation="Horizontal">
                    <Label Text="RAG / Поиск:" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding IsWebSearchEnabled}" HorizontalOptions="EndAndExpand" />
                </StackLayout>

                <Label Text="{Binding TemperatureText, StringFormat='Temperature: {0}'}" FontSize="12" />
                <Slider Minimum="0.0" Maximum="2.0" Value="{Binding Temperature}" />

                <Label Text="{Binding TopPText, StringFormat='Top-P: {0}'}" FontSize="12" />
                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding TopP}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ПРАВАЯ ПАНЕЛЬ: Чат и ввод сообщений -->
        <Grid Grid.Column="1" RowDefinitions="*, Auto" Padding="15" RowSpacing="10">

            <!-- Список сообщений -->
            <CollectionView x:Name="MessagesCollectionView"
                            Grid.Row="0"
                            ItemsSource="{Binding Messages}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Padding="8" Margin="0,4">
                            <Frame CornerRadius="10" 
                                   Padding="12"
                                   HasShadow="False"
                                   BackgroundColor="{Binding IsUser, Converter={StaticResource BoolToColorConverter}, FallbackValue='#2A2A2A'}">
                                <VerticalStackLayout Spacing="4">
                                    <!-- Исправлено: TextColor вместо ForegroundColor -->
                                    <Label Text="{Binding SenderName}" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                                    <Label Text="{Binding Text}" FontSize="14" LineBreakMode="WordWrap" />
                                    <!-- Исправлено: TextColor вместо ForegroundColor -->
                                    <Label Text="{Binding SpeedText}" FontSize="10" TextColor="DarkGray" HorizontalOptions="End" IsVisible="{Binding SpeedText, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Область ввода сообщения -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" 
                       Placeholder="Введите запрос к системному аналитику..." 
                       Text="{Binding UserInputText, Mode=TwoWay}"
                       ReturnCommand="{Binding SendMessageCommand}" />

                <Button Grid.Column="1" 
                        Text="Отправить" 
                        Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding IsNotGenerating}" />

                <Button Grid.Column="2" 
                        Text="Стоп" 
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding IsGenerating}"
                        BackgroundColor="IndianRed" />
            </Grid>

        </Grid>
    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SyrlasStudio.ViewModels"
             xmlns:models="clr-namespace:SyrlasStudio.Models"
             x:Class="SyrlasStudio.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             x:Name="RootPage"
             BackgroundColor="#18181B">

    <Grid ColumnDefinitions="280, *">

        <!-- Левая боковая панель (Сайдбар) -->
        <Grid Grid.Column="0" 
              RowDefinitions="Auto, Auto, *, Auto, Auto" 
              Padding="20" 
              BackgroundColor="#202023">

            <!-- Заголовок приложения -->
            <Label Grid.Row="0" 
                   Text="Syrlas Studio" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#A78BFA" 
                   Margin="0,0,0,20" />

            <!-- Кнопка Нового чата -->
            <Button Grid.Row="1" 
                    Text="+ Новый чат" 
                    Command="{Binding NewChatCommand}"
                    BackgroundColor="#27272A" 
                    TextColor="White" 
                    CornerRadius="8" 
                    HeightRequest="44" 
                    FontAttributes="Bold" 
                    Margin="0,0,0,20" />

            <!-- История сессий -->
            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Label Text="История сессий" 
                       TextColor="#A1A1AA" 
                       FontSize="13" 
                       FontAttributes="Bold" />
                <Label Text="Сессии отсутствуют" 
                       TextColor="#52525B" 
                       FontSize="12" 
                       Margin="0,10,0,0" />
            </VerticalStackLayout>

            <!-- Метрики ресурсов (CPU, RAM, Disk) -->
            <VerticalStackLayout Grid.Row="3" Spacing="12" Margin="0,10,0,15">
                
                <!-- CPU -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="CPU" TextColor="#A1A1AA" FontSize="11" />
                        <Label Grid.Column="1" Text="{Binding CpuUsageText}" TextColor="#38BDF8" FontSize="11" FontAttributes="Bold" />
                    </Grid>
                    <ProgressBar Progress="{Binding CpuProgress}" ProgressColor="#0EA5E9" HeightRequest="4" />
                </VerticalStackLayout>

                <!-- RAM -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="RAM" TextColor="#A1A1AA" FontSize="11" />
                        <Label Grid.Column="1" Text="{Binding RamUsageText}" TextColor="#A78BFA" FontSize="11" FontAttributes="Bold" />
                    </Grid>
                    <ProgressBar Progress="{Binding RamProgress}" ProgressColor="#8B5CF6" HeightRequest="4" />
                </VerticalStackLayout>

                <!-- Disk -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Disk" TextColor="#A1A1AA" FontSize="11" />
                        <Label Grid.Column="1" Text="{Binding DiskUsageText}" TextColor="#34D399" FontSize="11" FontAttributes="Bold" />
                    </Grid>
                    <ProgressBar Progress="{Binding DiskProgress}" ProgressColor="#10B981" HeightRequest="4" />
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- Системный лог -->
            <Border Grid.Row="4" 
                    BackgroundColor="#18181B" 
                    Stroke="#27272A" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 8" 
                    Padding="12" 
                    HeightRequest="160">
                <VerticalStackLayout Spacing="8">
                    <Label Text="СИСТЕМНЫЙ ЛОГ" 
                           TextColor="#71717A" 
                           FontSize="11" 
                           FontAttributes="Bold" />
                    <ScrollView HeightRequest="120">
                        <CollectionView ItemsSource="{Binding SystemLogs}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" 
                                           TextColor="#A1A1AA" 
                                           FontFamily="Consolas" 
                                           FontSize="11" 
                                           Margin="0,2" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Правая область (Чат и Поле ввода) -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Padding="25">

            <!-- Шапка чата -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                <Label Grid.Column="0" 
                       Text="Syrlas AI Assistant" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       VerticalOptions="Center" />
                <Label Grid.Column="1" 
                       Text="Qwen 2.5 Coder (Local Engine)" 
                       TextColor="#8B5CF6" 
                       FontSize="12" 
                       VerticalOptions="Center" />
            </Grid>

            <!-- Список сообщений -->
            <CollectionView Grid.Row="1" 
                            ItemsSource="{Binding Messages}" 
                            x:Name="MessagesCollectionView" 
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <VerticalStackLayout Spacing="6" Margin="0,10">

                            <!-- Имя отправителя -->
                            <Label Text="{Binding SenderName}" 
                                   TextColor="#A1A1AA" 
                                   FontSize="12" 
                                   FontAttributes="Bold" />

                            <!-- Пузырь сообщения -->
                            <Border Stroke="Transparent" 
                                    BackgroundColor="#27272A" 
                                    StrokeShape="RoundRectangle 12" 
                                    Padding="14,12" 
                                    HorizontalOptions="Start">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Text}" 
                                           TextColor="White" 
                                           FontSize="14" 
                                           LineBreakMode="WordWrap" />

                                    <!-- Кнопка копирования кода -->
                                    <Button Text="Копировать код"
                                            Command="{Binding BindingContext.CopyCodeCommand, Source={x:Reference RootPage}}"
                                            CommandParameter="{Binding Text}"
                                            IsVisible="{Binding HasCode}"
                                            BackgroundColor="#3F3F46"
                                            TextColor="White"
                                            FontSize="11"
                                            HeightRequest="30"
                                            Padding="12,0"
                                            HorizontalOptions="End"
                                            CornerRadius="6" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Панель ввода (Белое плавное поле) -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,15,0,0">

                <!-- Контейнер для поля ввода -->
                <Border Grid.Column="0"
                        Stroke="Transparent" 
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 25"
                        BackgroundColor="White"
                        Margin="0,0,12,0">

                    <Entry Text="{Binding UserInputText}"
                           Placeholder="Спросите что-нибудь у Syrlas AI..."
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           HeightRequest="48"
                           Margin="16,0" />
                </Border>

                <!-- Кнопка Отправить -->
                <Button Grid.Column="1"
                        Text="Отправить"
                        Command="{Binding SendMessageCommand}"
                        BackgroundColor="#8B5CF6"
                        TextColor="White"
                        CornerRadius="24"
                        HeightRequest="48"
                        Padding="26,0"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
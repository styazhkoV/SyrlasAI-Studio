<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SyrlasStudio.ViewModels"
             xmlns:models="clr-namespace:SyrlasStudio.Models"
             x:Class="SyrlasStudio.MainPage"
             x:DataType="vm:MainPageViewModel"
             x:Name="RootPage"
             Title="Syrlas Studio"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}">

    <!-- Корневая сетка: Левая панель (280) и Правая зона диалога (*) -->
    <Grid ColumnDefinitions="280, *">

        <!-- 1. ЛЕВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0"
                BackgroundColor="{AppThemeBinding Light=#F0F2F5, Dark=#252526}"
                StrokeThickness="0"
                StrokeShape="Rectangle">
            <Grid RowDefinitions="Auto, *, Auto" Padding="12">
                <Button Grid.Row="0"
                        Text="+ Новый чат"
                        Margin="0,0,0,12"
                        BackgroundColor="#2B2D30"
                        TextColor="White"
                        CornerRadius="8" />

                <Label Grid.Row="1" 
                       Text="История сессий..." 
                       TextColor="Gray" 
                       FontSize="13" />

                <StackLayout Grid.Row="2" Padding="0,10,0,0">
                    <Label Text="Syrlas Core: Active" 
                           FontSize="12" 
                           TextColor="Gray" 
                           HorizontalOptions="Center" />
                </StackLayout>
            </Grid>
        </Border>

        <!-- 2. ПРАВАЯ ПАНЕЛЬ -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">

            <!-- Хедер -->
            <Border Grid.Row="0" 
                    Padding="16,12" 
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D2D}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3E3E42}">
                <Grid ColumnDefinitions="*, Auto">
                    <StackLayout Grid.Column="0" Orientation="Vertical">
                        <Label Text="Ассистент разработчика"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Модель: Qwen 2.5 Coder | Local Engine"
                               FontSize="12"
                               TextColor="Gray" />
                    </StackLayout>
                </Grid>
            </Border>

            <!-- Список сообщений -->
            <CollectionView x:Name="MessagesCollectionView"
                            Grid.Row="1"
                            ItemsSource="{Binding Messages}"
                            SelectionMode="None"
                            Margin="16">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Padding="0,6">
                            <Border MaximumWidthRequest="750"
                                    StrokeThickness="0"
                                    Padding="14,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <!-- Выравнивание и цвет через DataTrigger -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalOptions" Value="Start" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E9ECEF, Dark=#2B2D30}" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="HorizontalOptions" Value="End" />
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#005FB8, Dark=#0E639C}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackLayout Spacing="6">
                                    <Label Text="{Binding SenderName}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="Gray" />

                                    <Label Text="{Binding Text}"
                                           FontSize="14"
                                           LineBreakMode="WordWrap" />

                                    <!-- Кнопка Apply to File через x:Reference RootPage (исправлен пробел и имя ссылки) -->
                                    <Button Text="{Binding AppliedStatusText}"
                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ApplyCodeToFileCommand}" 
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding HasCode}"
                                            FontSize="11"
                                            HeightRequest="30"
                                            Padding="10,0"
                                            CornerRadius="6"
                                            BackgroundColor="#007ACC"
                                            TextColor="White" />
                                </StackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Ввод сообщения -->
            <Border Grid.Row="2"
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D2D}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3E3E42}">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Editor Grid.Column="0"
                            Text="{Binding InputText, Mode=TwoWay}"
                            Placeholder="Введите запрос или промпт..."
                            AutoSize="TextChanges"
                            MaximumHeightRequest="150"
                            FontSize="14" />

                    <Button Grid.Column="1"
                            Text="Отправить"
                            Command="{Binding SendMessageCommand}"
                            VerticalOptions="End"
                            HeightRequest="40"
                            Padding="16,0" />
                </Grid>
            </Border>

        </Grid>

    </Grid>
</ContentPage>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SyrlasStudio</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Идентификация приложения -->
    <ApplicationTitle>SyrlasStudio</ApplicationTitle>
    <ApplicationId>com.syrlas.syrlasstudio</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Минимальная версия macOS/MacCatalyst -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>

    <!-- Игнорирование проверок версий Xcode и уязвимостей NuGet -->
    <_SkipXcodeVersionCheck>true</_SkipXcodeVersionCheck>
    <MtouchExtraArgs>--skip-xcode-check</MtouchExtraArgs>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <!-- Конфигурация Debug: отключение линкера ILLink для предотвращения ошибки MT0180 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PublishTrimmed>false</PublishTrimmed>
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <!-- Конфигурация Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCodeSigning Condition="'$(EnableCodeSigning)' == ''">true</EnableCodeSigning>
    <CodesignKey Condition="'$(CodesignKey)' == ''">-</CodesignKey>
    <CodesignEntitlements>Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
    <RuntimeIdentifiers>maccatalyst-arm64;maccatalyst-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- 1. Удаление не-macOS файлов до этапа копирования и сбора ресурсов -->
  <Target Name="PurgeNonMacRuntimesBeforeBundle" 
          BeforeTargets="AssignTargetPaths;_ComputeNativeLibraries;_CollectBundleResources;_CopyFilesToBundle;_CreateAppBundle;_GetNativeFilesToBundle;Build" 
          AfterTargets="ResolvePackageAssets;ResolveAssemblyReferences">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" 
        Condition="$([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/win')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\win')) or '%(Extension)' == '.so' or '%(Extension)' == '.dll'" />

      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" 
        Condition="$([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/win')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\win')) or '%(Extension)' == '.so' or '%(Extension)' == '.dll'" />

      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" 
        Condition="$([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/win')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\win')) or '%(Extension)' == '.so'" />

      <Content Remove="@(Content)" 
               Condition="$([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/win')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\win')) or '%(Extension)' == '.so'" />

      <None Remove="@(None)" 
            Condition="$([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/win')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\win')) or '%(Extension)' == '.so'" />
    </ItemGroup>
  </Target>

  <!-- 2. Очистка внутренних списков нативных библиотек MacCatalyst SDK после их расчёта -->
  <Target Name="PurgeNativeLibrariesAfterCompute" AfterTargets="_ComputeNativeLibraries">
    <ItemGroup>
      <_NativeLibrary Remove="@(_NativeLibrary)" 
        Condition="$([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/win')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\win')) or '%(Extension)' == '.so'" />

      <_BundleResourceWithLogicalName Remove="@(_BundleResourceWithLogicalName)" 
        Condition="$([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/win')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\win')) or '%(Extension)' == '.so'" />

      <NativeReference Remove="@(NativeReference)" 
        Condition="$([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\linux')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes/win')) or $([System.String]::Copy('%(Identity)').ToLower().Contains('runtimes\win')) or '%(Extension)' == '.so'" />
    </ItemGroup>
  </Target>

  <!-- Ресурсы MAUI -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Зависимости NuGet -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- Зависимости проектов решений -->
  <ItemGroup>
    <ProjectReference Include="..\SyrlasAIEngine\SyrlasAIEngine.csproj" />
  </ItemGroup>

</Project>
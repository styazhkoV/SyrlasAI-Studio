    <Import Project="$(NuGetPackageRoot)llamasharp.backend.cuda12.windows\0.27.0\build\netstandard2.0\LLamaSharp.Backend.Cuda12.Windows.props" Condition="Exists('$(NuGetPackageRoot)llamasharp.backend.cuda12.windows\0.27.0\build\netstandard2.0\LLamaSharp.Backend.Cuda12.Windows.props')" />
    <Import Project="$(NuGetPackageRoot)llamasharp.backend.cuda12.linux\0.27.0\build\netstandard2.0\LLamaSharp.Backend.Cuda12.Linux.props" Condition="Exists('$(NuGetPackageRoot)llamasharp.backend.cuda12.linux\0.27.0\build\netstandard2.0\LLamaSharp.Backend.Cuda12.Linux.props')" />
